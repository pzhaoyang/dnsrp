#!/bin/bash
#
# 安装后：初始化数据目录、自检能力、写默认配置。
#
# 此时应用文件已落盘，应用用户也已创建，可以准确做权限准备。

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
. "${HERE}/common.sh" 2>/dev/null || {
    echo "[DNS-RP] 无法加载 common.sh"
    exit 0
}

PKGVAR=$(dnrp_pkgvar)
APPDEST=$(dnrp_appdest)

dnrp_log "========== install_callback =========="

mkdir -p "$PKGVAR" 2>/dev/null || true
chmod +x "${APPDEST}"/ui/*.cgi 2>/dev/null || true

# ---- 1. Python 环境 ----
PY=$(dnrp_python) || { dnrp_log "错误：缺少 python3"; exit 0; }
dnrp_check_python || true

# ---- 2. 数据库初始化 ----
APP_PY="${APPDEST}/dnrp"
if [ -d "$APP_PY" ] && [ "$(id -u)" = "0" ]; then
    if PYTHONPATH="$APPDEST" "$PY" -c "from dnrp import store; store.init_db(); print('ok')" 2>/dev/null | grep -q ok; then
        dnrp_log "SQLite 已初始化"
    else
        dnrp_log "SQLite 初始化失败（首次启动时会自动重试）"
    fi
fi

# ---- 3. 证书权限（应用用户此时已存在）----
APP_USERNAME=$(dnrp_detect_user "" 2>/dev/null || true)
if [ -n "$APP_USERNAME" ]; then
    dnrp_log "应用用户: $APP_USERNAME"
    if [ "$(id -u)" = "0" ]; then
        dnrp_ensure_wwwdata "$APP_USERNAME" || true
        dnrp_verify_cert_access "$APP_USERNAME" \
            && dnrp_log "证书全部可读，HTTPS 反代可用" \
            || dnrp_log "存在不可读证书：重启应用后生效"
    fi
else
    dnrp_log "未能确定应用用户，跳过证书权限检查"
fi

# ---- 4. DDNS 能力 ----
if [ "$(id -u)" = "0" ]; then
    dnrp_verify_ddns_access || dnrp_log "DDNS 功能将不可用（不影响反代与证书）"
fi

# ---- 5. 默认配置 ----
CONF="${PKGVAR}/dnrp.conf"
if [ ! -f "$CONF" ]; then
    cat > "$CONF" <<'EOF'
# DNS-RP 默认配置
# 反代监听端口刻意避开 fnOS 系统端口（80/443/16666/16667）
default_listen_port = 8080
EOF
    dnrp_log "默认配置已创建: $CONF"
fi

if [ ! -f "$PKGVAR/dnrp.db" ]; then
    dnrp_log "数据库尚未创建，首次启动时生成"
fi

dnrp_log "提示：请到应用中心启动 DNS-RP，然后打开界面配置反代规则"
dnrp_log "========== install_callback 完成 =========="
exit 0
